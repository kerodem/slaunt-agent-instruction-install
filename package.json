{
  "name": "slaunt-install",
  "version": "0.1.2",
  "description": "A guided, append-only installer for Slaunt instructions in Claude Code and Codex.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "commonjs",
  "main": "src/installer.js",
  "bin": {
    "slaunt-install": "bin/cli.js",
    "slaunt-agent-instruction-install": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "instructions.md",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "node --check bin/cli.js && node --check src/installer.js && node --check test/installer.test.js",
    "pack:check": "npm pack --dry-run",
    "test": "node --test"
  },
  "keywords": [
    "agents.md",
    "claude-code",
    "codex",
    "instruction-files",
    "npx",
    "slaunt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerodem/slaunt-agent-instruction-install.git"
  },
  "bugs": {
    "url": "https://github.com/kerodem/slaunt-agent-instruction-install/issues"
  },
  "homepage": "https://github.com/kerodem/slaunt-agent-instruction-install"
}
